<%- include('partials/header', { pageTitle: 'VisionVogue — Luxury Eyewear Redefined' }) %>

<!-- Hero Slider Section -->
<section class="hero-slider mb-5" id="heroSlider">
  <div class="hero-slide active">
    <img src="/images/hero-slides/slide-1-rayban-meta.jpg" alt="Ray-Ban Meta Smart Glasses">
  </div>
  <div class="hero-slide">
    <img src="/images/hero-slides/slide-2-aurix-smart.jpg" alt="Aurix Smart Sunglasses — Wear the Future">
  </div>
  <div class="hero-slide">
    <img src="/images/hero-slides/slide-3-get-styles.jpg" alt="Get Styles That Make You Shine — 15% Off">
  </div>
  <div class="hero-slide">
    <img src="/images/hero-slides/slide-4-buy1get1.jpg" alt="Buy 1 Get 1 Free — Blaze Collection">
  </div>
  <div class="hero-slide">
    <img src="/images/hero-slides/slide-5-holiday-arrivals.jpg" alt="Holiday Season New Arrivals">
  </div>

  <div class="hero-arrow prev"><i class="fa-solid fa-chevron-left"></i></div>
  <div class="hero-arrow next"><i class="fa-solid fa-chevron-right"></i></div>

  <div class="hero-slider-overlay">
    <div class="hero-slider-cta">
      <a href="/products" class="btn-lux">Shop Collection <i class="fa-solid fa-arrow-right"></i></a>
      <a href="/virtual-try-on" class="btn-outline-lux" style="background:rgba(255,255,255,0.15); border-color:#fff; color:#fff;">Try Virtually</a>
    </div>
    <div class="hero-slider-dots">
      <button class="hero-dot active"></button>
      <button class="hero-dot"></button>
      <button class="hero-dot"></button>
      <button class="hero-dot"></button>
      <button class="hero-dot"></button>
    </div>
  </div>
</section>

<div class="container-xl" style="padding-bottom:80px;">

  <!-- Section 1: Shop by Category -->
  <div class="mb-5 pb-3">
    <div class="section-head reveal mt-0">
      <div>
        <span class="text-gold text-uppercase fw-semibold" style="letter-spacing:1.5px; font-size:12px;">Explore Categories</span>
        <h2 class="font-display display-5 fw-bold text-dark mb-0">Shop by Category</h2>
        <p class="text-muted small">Curated collections for every face shape, style, and visual requirement.</p>
      </div>
    </div>
    <div class="cat-grid">
      <a href="/products/category/Eyeglasses" class="cat-tile reveal">
        <img src="/images/categories/eyeglasses-cover.jpg" alt="Eyeglasses Collection" loading="lazy">
        <div class="cat-label"><h3>Eyeglasses</h3></div>
      </a>
      <a href="/products/category/Sunglasses" class="cat-tile reveal">
        <img src="/images/categories/sunglasses-cover.jpg" alt="Sunglasses Collection" loading="lazy">
        <div class="cat-label"><h3>Sunglasses</h3></div>
      </a>
      <a href="/products/category/Contact%20Lenses" class="cat-tile reveal">
        <img src="/images/categories/contacts-cover.jpg" alt="Contact Lenses Collection" loading="lazy">
        <div class="cat-label"><h3>Contact Lenses</h3></div>
      </a>
      <a href="/special-power" class="cat-tile reveal">
        <img src="/images/categories/special-power-cover.jpg" alt="Special Power Lenses" loading="lazy">
        <div class="cat-label"><h3>Special Power</h3></div>
      </a>
    </div>
  </div>

  <!-- Section 2: Shop by Gender Showcase (Men & Women) -->
  <div class="mb-5 pb-3">
    <div class="section-head reveal">
      <div>
        <span class="text-gold text-uppercase fw-semibold" style="letter-spacing:1.5px; font-size:12px;">Bespoke Fits</span>
        <h2 class="font-display display-5 fw-bold text-dark mb-0">Curated Gender Edits</h2>
        <p class="text-muted small">Precision-fit frames designed specifically for Men's and Women's facial contours.</p>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-md-6">
        <a href="/products?gender=Men" class="card border-0 shadow-sm overflow-hidden text-white rounded-4 reveal position-relative" style="min-height:240px; background:linear-gradient(135deg, #1c1c1c, #2b2b2b); text-decoration:none;">
          <div class="p-4 p-md-5 d-flex flex-column justify-content-between h-100 z-1">
            <div>
              <span class="badge bg-gold text-dark text-uppercase mb-2" style="letter-spacing:1px;"><i class="fa-solid fa-mars me-1"></i> Men's Optics</span>
              <h3 class="font-display display-6 fw-bold text-white mb-1">Men's Eyewear Collection</h3>
              <p class="text-white-50 small mb-0">Full Rim, Aviators, Titanium Alloys & Polarized UV400 Shields</p>
            </div>
            <div class="mt-4">
              <span class="btn-lux" style="font-size:12.5px;">Shop Men's Collection <i class="fa-solid fa-arrow-right ms-1"></i></span>
            </div>
          </div>
        </a>
      </div>
      <div class="col-md-6">
        <a href="/products?gender=Women" class="card border-0 shadow-sm overflow-hidden text-white rounded-4 reveal position-relative" style="min-height:240px; background:linear-gradient(135deg, #2b2b2b, #3d2238); text-decoration:none;">
          <div class="p-4 p-md-5 d-flex flex-column justify-content-between h-100 z-1">
            <div>
              <span class="badge bg-gold text-dark text-uppercase mb-2" style="letter-spacing:1px;"><i class="fa-solid fa-venus me-1"></i> Women's Couture</span>
              <h3 class="font-display display-6 fw-bold text-white mb-1">Women's Eyewear Collection</h3>
              <p class="text-white-50 small mb-0">Cat Eye, Oversized Acetate, Crystal Frames & Fashion Tinted Gradient</p>
            </div>
            <div class="mt-4">
              <span class="btn-lux" style="font-size:12.5px;">Shop Women's Collection <i class="fa-solid fa-arrow-right ms-1"></i></span>
            </div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <!-- Section 3: New Arrivals -->
  <div class="mb-5 pb-3">
    <div class="section-head reveal">
      <div>
        <span class="text-gold text-uppercase fw-semibold" style="letter-spacing:1.5px; font-size:12px;">Fresh Releases</span>
        <h2 class="font-display display-5 fw-bold text-dark mb-0">New Arrivals</h2>
        <p class="text-muted small">Fresh off the design table — this season's statement frames.</p>
      </div>
      <a href="/products" class="btn-outline-lux">View All</a>
    </div>
    <div class="product-grid">
      <% newArrivals.forEach(p => { %>
        <%- include('partials/product-card', { p }) %>
      <% }) %>
    </div>
  </div>

  <!-- Section 4: Best Sellers -->
  <div class="mb-5 pb-3">
    <div class="section-head reveal">
      <div>
        <span class="text-gold text-uppercase fw-semibold" style="letter-spacing:1.5px; font-size:12px;">Customer Favorites</span>
        <h2 class="font-display display-5 fw-bold text-dark mb-0">Best Sellers</h2>
        <p class="text-muted small">Loved by thousands — our most-reviewed and iconic frame silhouettes.</p>
      </div>
      <a href="/products" class="btn-outline-lux">View All</a>
    </div>
    <div class="product-grid">
      <% bestSellers.forEach(p => { %>
        <%- include('partials/product-card', { p }) %>
      <% }) %>
    </div>
  </div>

  <!-- Section 5: Sunglasses Edit -->
  <div class="mb-5 pb-3">
    <div class="section-head reveal">
      <div>
        <span class="text-gold text-uppercase fw-semibold" style="letter-spacing:1.5px; font-size:12px;">Outdoor Protection</span>
        <h2 class="font-display display-5 fw-bold text-dark mb-0">Sunglasses Edit</h2>
        <p class="text-muted small">UV400 protected, polarized, anti-glare, always on-trend.</p>
      </div>
      <a href="/products/category/Sunglasses" class="btn-outline-lux">View All</a>
    </div>
    <div class="product-grid">
      <% sunglasses.forEach(p => { %>
        <%- include('partials/product-card', { p }) %>
      <% }) %>
    </div>
  </div>

  <!-- Section 6: Lens Technology Feature Strip -->
  <div class="mb-5 pb-3">
    <div class="section-head reveal">
      <div>
        <span class="text-gold text-uppercase fw-semibold" style="letter-spacing:1.5px; font-size:12px;">Precision Engineering</span>
        <h2 class="font-display display-5 fw-bold text-dark mb-0">Engineered for Clarity</h2>
        <p class="text-muted small">Premium optical coatings and shatterproof lenses built into every pair.</p>
      </div>
    </div>
    <div class="feature-strip">
      <div class="feature-card reveal">
        <img src="/images/marketing/water-repellent-feature.jpg" alt="Water Repellent Lenses">
        <div class="feature-tag"><i class="fa-solid fa-droplet text-gold"></i> Hydrophobic Water & Oil Repellent</div>
      </div>
      <div class="feature-card reveal">
        <img src="/images/marketing/uv-protection-feature.jpg" alt="100% UV Protection">
        <div class="feature-tag"><i class="fa-solid fa-sun text-gold"></i> 100% UV400 Full Spectrum Shield</div>
      </div>
    </div>
  </div>

  <!-- Section 7: Brand Editorial Philosophy -->
  <div class="editorial-banner reveal rounded-4 overflow-hidden shadow-sm">
    <img src="/images/marketing/brand-editorial-banner.jpg" alt="VisionVogue Editorial">
    <div class="editorial-content p-4 p-md-5">
      <p class="tagline text-gold text-uppercase fw-semibold mb-2" style="letter-spacing:2px;">The VisionVogue Philosophy</p>
      <h2 class="font-display display-4 fw-bold text-white mb-0">Only One Point of View —<br>Make It Yours</h2>
    </div>
  </div>

</div>

<%- include('partials/footer', { extraScripts: '<script src="/js/hero-slider.js"></script>' }) %>
