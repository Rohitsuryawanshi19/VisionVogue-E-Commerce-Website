<%- include('../partials/header', { pageTitle: 'Create Account — VisionVogue' }) %>

<div class="container-xl" style="max-width:460px; padding:80px 24px;">
  <div class="sidebar-filter reveal" style="padding:40px;">
    <h2 style="text-align:center;margin-bottom:6px;">Create Account</h2>
    <p style="text-align:center;color:var(--text-muted);margin-bottom:26px;font-size:14px;">Join VisionVogue for faster checkout & order tracking.</p>
    <form action="/auth/register" method="POST">
      <div class="mb-3"><input type="text" name="name" placeholder="Full Name" required style="padding:12px 16px;border-radius:8px;border:1px solid #ddd;width:100%;"></div>
      <div class="mb-3"><input type="email" name="email" placeholder="Email" required style="padding:12px 16px;border-radius:8px;border:1px solid #ddd;width:100%;"></div>
      <div class="mb-3"><input type="text" name="phone" placeholder="Phone Number" style="padding:12px 16px;border-radius:8px;border:1px solid #ddd;width:100%;"></div>
      <div class="mb-3"><input type="password" name="password" placeholder="Password" required style="padding:12px 16px;border-radius:8px;border:1px solid #ddd;width:100%;"></div>
      <button type="submit" class="btn-lux" style="width:100%;justify-content:center;">Create Account</button>
    </form>
    <p style="text-align:center;margin-top:20px;font-size:13.5px;">Already have an account? <a href="/auth/login" style="color:var(--gold);font-weight:600;">Login</a></p>
  </div>
</div>

<%- include('../partials/footer') %>
