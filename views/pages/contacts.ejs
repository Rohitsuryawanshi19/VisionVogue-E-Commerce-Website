<%- include('../partials/header', { pageTitle: 'Contact Support — VisionVogue' }) %>

<div class="container-xl" style="padding-top:40px; padding-bottom:80px;">

  <!-- Hero Header -->
  <div class="text-center mb-5 reveal">
    <span class="badge bg-dark text-gold px-3 py-2 text-uppercase letter-spacing-1 mb-2" style="font-size:11px; letter-spacing:2px; border: 1px solid #c9a35c;">Customer Care & Support</span>
    <h1 class="font-display display-4 text-dark fw-bold mt-2">How Can We Assist You Today?</h1>
    <p class="text-muted mx-auto" style="max-width:680px; font-size:16.5px; line-height:1.7;">
      Have a question about your optical prescription, order status, or frame fitting? Our dedicated team of optical specialists is available 7 days a week.
    </p>
  </div>

  <div class="row g-4 mb-5">
    <!-- Quick Contact Details -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm p-4 h-100 bg-dark text-white rounded-4">
        <h3 class="font-display h4 fw-bold text-gold mb-4">Direct Touchpoints</h3>

        <div class="d-flex align-items-start mb-4">
          <div class="icon-wrap me-3" style="width:46px; height:46px; background:rgba(201,163,92,0.15); color:var(--gold); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0;">
            <i class="fa-solid fa-phone"></i>
          </div>
          <div>
            <span class="text-white-50 small text-uppercase d-block">Toll Free Helpline</span>
            <strong class="h5 text-white mb-0">1800-123-4567</strong>
            <p class="text-white-50 small mb-0 mt-1">Mon – Sat: 9:00 AM – 9:00 PM</p>
          </div>
        </div>

        <div class="d-flex align-items-start mb-4">
          <div class="icon-wrap me-3" style="width:46px; height:46px; background:rgba(201,163,92,0.15); color:var(--gold); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0;">
            <i class="fa-solid fa-envelope"></i>
          </div>
          <div>
            <span class="text-white-50 small text-uppercase d-block">Email Support</span>
            <a href="mailto:support@visionvogue.com" class="h6 text-gold mb-0 text-decoration-underline">support@visionvogue.com</a>
            <p class="text-white-50 small mb-0 mt-1">Response guaranteed within 2 hours</p>
          </div>
        </div>

        <div class="d-flex align-items-start mb-4">
          <div class="icon-wrap me-3" style="width:46px; height:46px; background:rgba(201,163,92,0.15); color:var(--gold); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0;">
            <i class="fa-solid fa-building-flag"></i>
          </div>
          <div>
            <span class="text-white-50 small text-uppercase d-block">Flagship Experience Center</span>
            <strong class="text-white d-block" style="font-size:14px;">VisionVogue Tower, Level 4</strong>
            <span class="text-white-50 small">Plot 88, Financial District, Bandra West, Mumbai 400050</span>
          </div>
        </div>

        <div class="pt-3 border-top border-secondary mt-auto">
          <span class="text-white-50 small d-block mb-2">Connect on Social Profiles:</span>
          <div class="d-flex gap-3 fs-5">
            <a href="https://instagram.com/visionvogue_official" target="_blank" class="text-gold"><i class="fa-brands fa-instagram"></i></a>
            <a href="https://facebook.com/visionvogue" target="_blank" class="text-gold"><i class="fa-brands fa-facebook-f"></i></a>
            <a href="https://twitter.com/visionvogue" target="_blank" class="text-gold"><i class="fa-brands fa-x-twitter"></i></a>
            <a href="mailto:support@visionvogue.com" class="text-gold"><i class="fa-solid fa-envelope"></i></a>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact Form -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white">
        <h3 class="font-display h3 fw-bold mb-2">Send Us a Direct Message</h3>
        <p class="text-muted small mb-4">Fill in your query details below and an optical consultant will get in touch with you.</p>

        <form id="contactForm" onsubmit="event.preventDefault(); document.getElementById('contactAlert').classList.remove('d-none'); this.reset();">
          <div id="contactAlert" class="alert alert-success d-none mb-4">
            <i class="fa-solid fa-circle-check me-2"></i> Thank you! Your message has been received. Our team will contact you shortly.
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold text-uppercase">Your Name *</label>
              <input type="text" class="form-control form-control-lg fs-6" placeholder="e.g. Rahul Sharma" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold text-uppercase">Email Address *</label>
              <input type="email" class="form-control form-control-lg fs-6" placeholder="name@example.com" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold text-uppercase">Phone Number</label>
              <input type="tel" class="form-control form-control-lg fs-6" placeholder="+91 98765 43210">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold text-uppercase">Query Category</label>
              <select class="form-select form-select-lg fs-6">
                <option value="prescription">Prescription / Power Assistance</option>
                <option value="order">Order Tracking & Delivery</option>
                <option value="special">Special Power Lens Query</option>
                <option value="returns">Returns & Refunds</option>
                <option value="other">General Inquiry</option>
              </select>
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold text-uppercase">Subject *</label>
              <input type="text" class="form-control form-control-lg fs-6" placeholder="Brief subject of your query" required>
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold text-uppercase">Your Message *</label>
              <textarea class="form-control form-control-lg fs-6" rows="4" placeholder="Please describe your question or prescription requirements..." required></textarea>
            </div>
            <div class="col-12 mt-4">
              <button type="submit" class="btn btn-dark btn-lg w-100 fw-semibold" style="background:var(--dark-grey); color:var(--gold);">
                Submit Query <i class="fa-solid fa-paper-plane ms-2"></i>
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Frequently Asked Questions -->
  <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border">
    <div class="text-center mb-4">
      <span class="text-gold text-uppercase fw-semibold" style="letter-spacing:1.5px; font-size:12px;">Quick Resolutions</span>
      <h2 class="font-display display-6 fw-bold mt-1">Frequently Asked Questions</h2>
    </div>

    <div class="accordion accordion-flush" id="faqAccordion">
      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button fw-semibold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
            How do I submit my prescription for Special Power or Progressive lenses?
          </button>
        </h2>
        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
          <div class="accordion-body text-muted small">
            You can upload an image or PDF of your doctor's prescription directly during checkout, or email it to support@visionvogue.com after placing your order. Our certified optometrists verify every power reading before grinding lenses.
          </div>
        </div>
      </div>

      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed fw-semibold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
            What is the delivery timeline for custom prescription glasses?
          </button>
        </h2>
        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
          <div class="accordion-body text-muted small">
            Standard single vision frames dispatch within 24-48 hours. High index, astigmatism, or progressive multi-focal lenses require 3-5 business days of digital surfacing and anti-glare curing.
          </div>
        </div>
      </div>

      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button collapsed fw-semibold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
            What is your return and exchange policy?
          </button>
        </h2>
        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
          <div class="accordion-body text-muted small">
            We offer a 14-day no-questions-asked return policy. If the frame fit isn't perfect, we will arrange a free home pickup and issue a full refund or frame exchange.
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
