<%- include('../partials/header', { pageTitle: 'Special Power Lenses — VisionVogue Studio' }) %>

<div class="container-xl" style="padding-top:40px; padding-bottom:80px;">

  <!-- Hero Header -->
  <div class="text-center mb-5 reveal">
    <span class="badge bg-dark text-gold px-3 py-2 text-uppercase letter-spacing-1 mb-2" style="font-size:11px; letter-spacing:2px; border: 1px solid #c9a35c;">Custom Optical Solutions</span>
    <h1 class="font-display display-4 text-dark fw-bold mt-2">Special Power & Prescription Lenses</h1>
    <p class="text-muted mx-auto" style="max-width:720px; font-size:16.5px; line-height:1.7;">
      Advanced digital lens surfacing for high cylindrical astigmatism, high minus/plus powers (-6.00 to -14.00 D), progressive multi-focals, and custom prism correction.
    </p>
  </div>

  <!-- Special Power Products Grid -->
  <% if (typeof products !== 'undefined' && products.length > 0) { %>
    <div class="section-head reveal mb-3">
      <div>
        <h2>Special Power Collection</h2>
        <p>Dataset frames engineered for high cylindrical power, progressives, and thick edge shielding.</p>
      </div>
      <a href="/products?category=Special+Power" class="btn-outline-lux">View All</a>
    </div>
    <div class="product-grid mb-5">
      <% products.forEach(p => { %>
        <%- include('../partials/product-card', { p }) %>
      <% }) %>
    </div>
  <% } %>

  <!-- Special Power Lens Categories Grid -->
  <div class="row g-4 mb-5">
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4" style="background:#fff;">
        <div class="icon-wrap mx-auto mb-3" style="width:58px; height:58px; background:var(--dark-grey); color:var(--gold); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:22px;">
          <i class="fa-solid fa-glasses"></i>
        </div>
        <h3 class="font-display h4 fw-bold mb-2">High Index (-6.00 to -14.00 D)</h3>
        <p class="text-muted small mb-3">Ultra-thin 1.67 and 1.74 index lenses engineered to minimize lens thickness and edge distortion for strong prescriptions.</p>
        <span class="badge bg-light text-dark border">Starting ₹2,499</span>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4" style="background:#fff;">
        <div class="icon-wrap mx-auto mb-3" style="width:58px; height:58px; background:var(--dark-grey); color:var(--gold); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:22px;">
          <i class="fa-solid fa-eye"></i>
        </div>
        <h3 class="font-display h4 fw-bold mb-2">High Astigmatism (Cyl Correction)</h3>
        <p class="text-muted small mb-3">Precision toric digital surfacing for high cylinder correction (Cyl up to -4.00) ensuring crisp, shadow-free peripheral vision.</p>
        <span class="badge bg-light text-dark border">Starting ₹2,899</span>
      </div>
    </div>

    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm p-4 text-center rounded-4" style="background:#fff;">
        <div class="icon-wrap mx-auto mb-3" style="width:58px; height:58px; background:var(--dark-grey); color:var(--gold); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:22px;">
          <i class="fa-solid fa-sliders"></i>
        </div>
        <h3 class="font-display h4 fw-bold mb-2">Progressive Multi-Focal</h3>
        <p class="text-muted small mb-3">Seamless transition zones between distance, reading, and computer vision without visible bifocal lines.</p>
        <span class="badge bg-light text-dark border">Starting ₹3,499</span>
      </div>
    </div>
  </div>

  <!-- Interactive Lens Power Calculator & Prescription Customizer Preview -->
  <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border mb-5">
    <div class="row align-items-center">
      <div class="col-lg-5 mb-4 mb-lg-0">
        <span class="text-gold text-uppercase fw-semibold" style="letter-spacing:1.5px; font-size:12px;">Interactive Preview</span>
        <h2 class="font-display display-6 fw-bold mt-1 mb-3">Special Power Lens Selector</h2>
        <p class="text-muted" style="font-size:15px; line-height:1.7;">
          Use our interactive prescription configurator to estimate lens thickness, weight, and pricing for your custom power readings.
        </p>
        <div class="p-3 bg-light rounded-3 border mt-3" style="font-size:13.5px;">
          <i class="fa-solid fa-circle-info text-gold me-2"></i>
          <strong>Optometrist Note:</strong> All special power orders undergo 2-step manual verification by our chief clinical optometrist before lens cutting.
        </div>
      </div>

      <div class="col-lg-7">
        <div class="p-4 bg-dark text-white rounded-4 shadow">
          <h4 class="font-display h5 text-gold mb-3"><i class="fa-solid fa-calculator me-2"></i> Custom Power Inputs</h4>

          <div class="table-responsive">
            <table class="table table-dark table-borderless align-middle mb-3" style="font-size:13.5px;">
              <thead>
                <tr class="text-gold border-bottom border-secondary">
                  <th>Eye</th>
                  <th>SPH (Sphere)</th>
                  <th>CYL (Cylinder)</th>
                  <th>AXIS</th>
                  <th>ADD</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="fw-bold">Right (OD)</td>
                  <td>
                    <select class="form-select form-select-sm bg-secondary text-white border-0">
                      <option>-0.50 D</option>
                      <option>-2.00 D</option>
                      <option selected>-6.50 D (Special High Power)</option>
                      <option>-9.00 D</option>
                    </select>
                  </td>
                  <td>
                    <select class="form-select form-select-sm bg-secondary text-white border-0">
                      <option>0.00</option>
                      <option selected>-1.75</option>
                      <option>-3.00</option>
                    </select>
                  </td>
                  <td><input type="text" class="form-control form-control-sm bg-secondary text-white border-0" value="90°"></td>
                  <td><input type="text" class="form-control form-control-sm bg-secondary text-white border-0" value="+1.75"></td>
                </tr>
                <tr>
                  <td class="fw-bold">Left (OS)</td>
                  <td>
                    <select class="form-select form-select-sm bg-secondary text-white border-0">
                      <option>-0.50 D</option>
                      <option>-2.00 D</option>
                      <option selected>-7.00 D (Special High Power)</option>
                      <option>-9.50 D</option>
                    </select>
                  </td>
                  <td>
                    <select class="form-select form-select-sm bg-secondary text-white border-0">
                      <option>0.00</option>
                      <option selected>-2.00</option>
                      <option>-3.50</option>
                    </select>
                  </td>
                  <td><input type="text" class="form-control form-control-sm bg-secondary text-white border-0" value="180°"></td>
                  <td><input type="text" class="form-control form-control-sm bg-secondary text-white border-0" value="+1.75"></td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
            <div>
              <span class="text-white-50 small d-block">Recommended Lens Material</span>
              <strong class="text-gold">1.74 Ultra Thin High Index + Blue Shield</strong>
            </div>
            <a href="/products" class="btn btn-outline-warning btn-sm">Explore Frames for Special Power <i class="fa-solid fa-arrow-right ms-1"></i></a>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>

<%- include('../partials/footer') %>
