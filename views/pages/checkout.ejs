<%- include('../partials/header', { pageTitle: 'Secure Checkout — VisionVogue Luxury Eyewear' }) %>

<div class="container-xl" style="padding-top:40px; padding-bottom:90px;">

  <!-- Step Tracker Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom reveal">
    <div>
      <span class="text-gold text-uppercase fw-semibold" style="letter-spacing:1.5px; font-size:12px;">Final Step</span>
      <h1 class="font-display display-5 text-dark fw-bold mb-0">Express Secure Checkout</h1>
    </div>
    <div class="d-flex align-items-center gap-3 mt-3 mt-md-0" style="font-size:13px; letter-spacing:0.5px;">
      <a href="/cart" class="text-muted text-decoration-none"><i class="fa-solid fa-bag-shopping me-1"></i> 1. Shopping Bag</a>
      <span class="text-muted"><i class="fa-solid fa-chevron-right text-light mx-1"></i></span>
      <span class="fw-bold text-dark border-bottom border-2 border-gold pb-1"><i class="fa-solid fa-credit-card me-1 text-gold"></i> 2. Payment & Address</span>
      <span class="text-muted"><i class="fa-solid fa-chevron-right text-light mx-1"></i></span>
      <span class="text-muted"><i class="fa-solid fa-circle-check me-1"></i> 3. Order Confirmed</span>
    </div>
  </div>

  <form id="checkoutForm" action="/cart/checkout" method="POST">
    <div class="row g-4">
      
      <!-- Left Column: Shipping & Payment Options -->
      <div class="col-lg-7">

        <!-- 1. Shipping Address Card -->
        <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-4 reveal">
          <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-4">
            <h3 class="font-display h4 fw-bold text-dark mb-0"><i class="fa-solid fa-location-dot text-gold me-2"></i> Shipping & Delivery Address</h3>
            <span class="badge bg-gold text-dark font-mono"><i class="fa-solid fa-shield-halved me-1"></i> SSL Encrypted</span>
          </div>

          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold text-uppercase">Full Name *</label>
              <input type="text" name="fullName" class="form-control py-2 fs-6" placeholder="e.g. Alexander Sterling" value="<%= typeof user !== 'undefined' && user ? user.name : '' %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold text-uppercase">Phone Number (For Delivery SMS) *</label>
              <input type="tel" name="phone" class="form-control py-2 fs-6" placeholder="+91 98765 43210" required>
            </div>
            <div class="col-12">
              <label class="form-label small fw-semibold text-uppercase">Flat, House No., Building, Street *</label>
              <input type="text" name="address" class="form-control py-2 fs-6" placeholder="e.g. 402, Royale Towers, Bandra West" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold text-uppercase">City *</label>
              <input type="text" name="city" class="form-control py-2 fs-6" placeholder="e.g. Mumbai" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold text-uppercase">Pincode *</label>
              <input type="text" name="pincode" class="form-control py-2 fs-6" placeholder="e.g. 400050" required>
            </div>
          </div>
        </div>

        <!-- 2. Payment Method Selector with 5-Minute Timer & Dynamic QR -->
        <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-4 reveal">
          <div class="d-flex align-items-center justify-content-between pb-3 border-bottom mb-3">
            <div>
              <h3 class="font-display h4 fw-bold text-dark mb-0"><i class="fa-solid fa-cash-register text-gold me-2"></i> Select Payment Method</h3>
              <p class="text-muted small mb-0">Secure instant payment with 5-minute reserved inventory lock.</p>
            </div>
            
            <!-- 5-Minute Expiry Countdown Badge -->
            <div class="text-end" id="timerContainer">
              <span class="text-muted d-block small" style="font-size:11px;">Payment Window</span>
              <span class="badge bg-danger text-white fs-6 font-mono px-3 py-1 shadow-sm" id="payTimerBadge">
                <i class="fa-solid fa-stopwatch me-1"></i> <span id="timerClock">05:00</span>
              </span>
            </div>
          </div>

          <!-- Timer Progress Bar -->
          <div class="progress mb-4" style="height: 6px; background:#eee;">
            <div id="timerProgressBar" class="progress-bar bg-warning progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%;"></div>
          </div>

          <!-- Hidden Expiry Banner -->
          <div id="expiryNotice" class="alert alert-danger d-none p-3 rounded-3 mb-4">
            <h5 class="fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation me-1"></i> Payment Session Expired (5 Minutes Limit)</h5>
            <p class="small mb-0">The 5-minute payment window for this order has expired to release inventory. Please refresh the page to start a new 5-minute payment session.</p>
            <button type="button" class="btn btn-outline-danger btn-sm mt-2" onclick="window.location.reload();">Refresh Payment Session</button>
          </div>

          <!-- Payment Tabs -->
          <div class="payment-tabs-wrapper" id="paymentContentArea">
            <div class="nav nav-pills nav-fill gap-2 mb-4" role="tablist">
              <button class="nav-link active py-3 border fw-semibold" id="tab-upi" data-bs-toggle="pill" data-bs-target="#pay-upi" type="button" role="tab" onclick="setPaymentMethod('UPI')">
                <i class="fa-solid fa-qrcode text-gold me-2"></i> UPI / QR Code
              </button>
              <button class="nav-link py-3 border fw-semibold" id="tab-card" data-bs-toggle="pill" data-bs-target="#pay-card" type="button" role="tab" onclick="setPaymentMethod('Card')">
                <i class="fa-regular fa-credit-card text-gold me-2"></i> Credit / Debit Card
              </button>
              <button class="nav-link py-3 border fw-semibold" id="tab-cod" data-bs-toggle="pill" data-bs-target="#pay-cod" type="button" role="tab" onclick="setPaymentMethod('COD')">
                <i class="fa-solid fa-hand-holding-dollar text-gold me-2"></i> Cash on Delivery
              </button>
            </div>

            <input type="hidden" name="paymentMethod" id="selectedPaymentMethod" value="UPI">
            <input type="hidden" name="paymentTxnId" id="paymentTxnId" value="TXN-<%= Date.now() %>">

            <div class="tab-content">
              
              <!-- Tab 1: UPI & Dynamic QR Code -->
              <div class="tab-pane fade show active" id="pay-upi" role="tabpanel">
                <div class="row align-items-center g-4 p-3 bg-light rounded-4 border">
                  <!-- QR Code Column -->
                  <div class="col-md-5 text-center">
                    <div class="bg-white p-3 rounded-4 shadow-sm d-inline-block border position-relative" style="max-width:240px;">
                      <img id="upiQrImage" src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=upi://pay?pa=visionvogue@upi&pn=VisionVogue%20Luxury&am=<%= subtotal %>&cu=INR&tn=Order%20Payment" alt="UPI QR Code" class="img-fluid rounded-3">
                      <div class="mt-2 text-center">
                        <span class="badge bg-dark text-gold font-mono" style="font-size:11px;">SCAN WITH ANY UPI APP</span>
                      </div>
                    </div>
                  </div>

                  <!-- UPI Apps & Details -->
                  <div class="col-md-7">
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <span class="fw-bold text-dark h5 mb-0">Pay ₹<%= subtotal.toLocaleString('en-IN') %> via UPI</span>
                    </div>
                    <p class="text-muted small mb-3">Scan this dynamic QR code with Google Pay, PhonePe, Paytm, or BHIM. Valid for 5 minutes.</p>
                    
                    <div class="d-flex flex-wrap gap-2 mb-3">
                      <span class="badge bg-white text-dark border p-2"><i class="fa-brands fa-google-pay text-primary me-1"></i> Google Pay</span>
                      <span class="badge bg-white text-dark border p-2"><i class="fa-solid fa-mobile-screen-button text-purple me-1" style="color:#5f259f;"></i> PhonePe</span>
                      <span class="badge bg-white text-dark border p-2"><i class="fa-solid fa-wallet text-info me-1"></i> Paytm</span>
                      <span class="badge bg-white text-dark border p-2"><i class="fa-solid fa-building-columns text-success me-1"></i> BHIM UPI</span>
                    </div>

                    <div class="form-check form-switch mb-3">
                      <input class="form-check-input" type="checkbox" id="simulatedUpiCheck" checked>
                      <label class="form-check-label small text-muted" for="simulatedUpiCheck">
                        Auto-approve simulated payment confirmation
                      </label>
                    </div>

                    <button type="button" class="btn btn-dark w-100 py-2 fw-semibold" style="background:var(--dark-grey); color:var(--gold);" onclick="submitOrderWithPayment('UPI')">
                      I Have Completed UPI Payment <i class="fa-solid fa-circle-check ms-1 text-gold"></i>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Tab 2: Credit / Debit Card -->
              <div class="tab-pane fade" id="pay-card" role="tabpanel">
                <div class="p-4 bg-light rounded-4 border">
                  <!-- Visual Interactive Card Preview -->
                  <div class="card-preview p-4 text-white rounded-4 shadow-sm mb-4" style="background: linear-gradient(135deg, #1c1c1c 0%, #343434 50%, #111111 100%); border: 1px solid var(--gold-soft);">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                      <span class="font-display text-gold fw-bold">VisionVogue VIP Card</span>
                      <i class="fa-brands fa-cc-visa fs-2 text-white"></i>
                    </div>
                    <div class="fs-4 font-mono text-gold-soft mb-3" id="cardDisplayNumber">4532 •••• •••• 8829</div>
                    <div class="d-flex justify-content-between align-items-end small">
                      <div>
                        <span class="text-white-50 d-block" style="font-size:10px;">CARD HOLDER</span>
                        <span class="fw-bold text-uppercase" id="cardDisplayName">ALEXANDER STERLING</span>
                      </div>
                      <div>
                        <span class="text-white-50 d-block" style="font-size:10px;">EXPIRES</span>
                        <span class="fw-bold" id="cardDisplayExp">12/28</span>
                      </div>
                    </div>
                  </div>

                  <div class="row g-3">
                    <div class="col-12">
                      <label class="form-label small fw-semibold text-uppercase">Card Number *</label>
                      <input type="text" id="cardNumberInput" class="form-control py-2" placeholder="4532 8910 2341 8829" maxlength="19" oninput="updateCardPreview()">
                    </div>
                    <div class="col-12">
                      <label class="form-label small fw-semibold text-uppercase">Cardholder Name *</label>
                      <input type="text" id="cardNameInput" class="form-control py-2 text-uppercase" placeholder="ALEXANDER STERLING" oninput="updateCardPreview()">
                    </div>
                    <div class="col-6">
                      <label class="form-label small fw-semibold text-uppercase">Expiry Date *</label>
                      <input type="text" id="cardExpInput" class="form-control py-2" placeholder="MM/YY" maxlength="5" oninput="updateCardPreview()">
                    </div>
                    <div class="col-6">
                      <label class="form-label small fw-semibold text-uppercase">CVV / CVC *</label>
                      <input type="password" id="cardCvvInput" class="form-control py-2" placeholder="•••" maxlength="4">
                    </div>
                  </div>

                  <button type="button" class="btn btn-dark w-100 py-3 fw-semibold mt-3" style="background:var(--dark-grey); color:var(--gold);" onclick="submitOrderWithPayment('Card')">
                    Pay ₹<%= subtotal.toLocaleString('en-IN') %> Securely via Card <i class="fa-solid fa-lock ms-2"></i>
                  </button>
                </div>
              </div>

              <!-- Tab 3: Cash on Delivery -->
              <div class="tab-pane fade" id="pay-cod" role="tabpanel">
                <div class="p-4 bg-light rounded-4 border text-center">
                  <div class="icon-wrap mx-auto mb-2" style="width:50px; height:50px; background:rgba(201,163,92,0.15); color:var(--gold); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:22px;">
                    <i class="fa-solid fa-truck-ramp-box"></i>
                  </div>
                  <h5 class="fw-bold text-dark mb-1">Cash on Delivery (Pay at Doorstep)</h5>
                  <p class="text-muted small mb-3">Pay cash or scan courier UPI machine when your luxury eyewear package arrives.</p>
                  <button type="button" class="btn btn-dark w-100 py-3 fw-semibold" style="background:var(--dark-grey); color:var(--gold);" onclick="submitOrderWithPayment('COD')">
                    Confirm COD Order (Pay ₹<%= subtotal.toLocaleString('en-IN') %> on Delivery) <i class="fa-solid fa-arrow-right ms-2"></i>
                  </button>
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Order Items Summary & Total -->
      <div class="col-lg-5">
        <div class="card border-0 shadow-sm p-4 rounded-4 bg-white sticky-top" style="top:90px;">
          <h3 class="font-display h4 fw-bold text-dark mb-3 pb-2 border-bottom">Order Items (<%= cart.reduce((s,i)=>s+i.qty,0) %>)</h3>

          <!-- Items Scroll Area -->
          <div class="checkout-items-list mb-3" style="max-height: 260px; overflow-y: auto;">
            <% cart.forEach(item => { %>
              <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                <img src="<%= item.image %>" alt="<%= item.name %>" class="rounded border p-1" style="width:54px; height:54px; object-fit:contain;">
                <div class="flex-grow-1">
                  <h6 class="fw-bold text-dark mb-0" style="font-size:13.5px;"><%= item.name %></h6>
                  <span class="text-muted small d-block" style="font-size:11.5px;"><%= item.lensUpgrade %> (Qty: <%= item.qty %>)</span>
                </div>
                <div class="fw-bold text-dark" style="font-size:14px;">
                  ₹<%= ((item.price + item.lensPrice) * item.qty).toLocaleString('en-IN') %>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Total Calculation Breakdown -->
          <div class="d-flex justify-content-between mb-2" style="font-size:14px;">
            <span class="text-muted">Item Subtotal</span>
            <span class="fw-semibold">₹<%= subtotal.toLocaleString('en-IN') %></span>
          </div>
          <div class="d-flex justify-content-between mb-2" style="font-size:14px;">
            <span class="text-muted">Lens Fitting & Assembly</span>
            <span class="fw-bold text-success">FREE</span>
          </div>
          <div class="d-flex justify-content-between mb-3" style="font-size:14px;">
            <span class="text-muted">Insured Express Shipping</span>
            <span class="fw-bold text-success">FREE</span>
          </div>

          <div class="border-top pt-3 mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <span class="text-uppercase fw-bold text-dark" style="letter-spacing:1px; font-size:14px;">Total Payable</span>
              <span class="font-display display-6 fw-bold text-dark">₹<%= subtotal.toLocaleString('en-IN') %></span>
            </div>
          </div>

          <div class="p-3 bg-light rounded-3 text-center border">
            <span class="text-muted small d-block"><i class="fa-solid fa-shield-cat me-1 text-gold"></i> VisionVogue 100% Satisfaction Guarantee</span>
            <span class="text-muted small d-block" style="font-size:11px;">1-Year Frame Warranty · 14-Day Hassle Free Returns</span>
          </div>
        </div>
      </div>

    </div>
  </form>

</div>

<script>
  // 5-Minute Live Expiry Timer (300 seconds)
  let timeRemaining = 300;
  const timerBadge = document.getElementById('payTimerBadge');
  const timerClock = document.getElementById('timerClock');
  const timerProgressBar = document.getElementById('timerProgressBar');
  const paymentContentArea = document.getElementById('paymentContentArea');
  const expiryNotice = document.getElementById('expiryNotice');

  const countdownInterval = setInterval(() => {
    timeRemaining--;
    const minutes = Math.floor(timeRemaining / 60);
    const seconds = timeRemaining % 60;
    const formattedTime = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    
    if (timerClock) timerClock.textContent = formattedTime;
    if (timerProgressBar) timerProgressBar.style.width = `${(timeRemaining / 300) * 100}%`;

    if (timeRemaining <= 60) {
      if (timerBadge) timerBadge.className = 'badge bg-danger text-white fs-6 font-mono px-3 py-1 shadow-sm blink-anim';
    }

    if (timeRemaining <= 0) {
      clearInterval(countdownInterval);
      if (timerClock) timerClock.textContent = 'EXPIRED';
      if (paymentContentArea) paymentContentArea.style.opacity = '0.35';
      if (paymentContentArea) paymentContentArea.style.pointerEvents = 'none';
      if (expiryNotice) expiryNotice.classList.remove('d-none');
    }
  }, 1000);

  function setPaymentMethod(method) {
    document.getElementById('selectedPaymentMethod').value = method;
  }

  function submitOrderWithPayment(method) {
    if (timeRemaining <= 0) {
      alert('Payment window has expired. Please refresh the page to start a new order session.');
      return;
    }
    document.getElementById('selectedPaymentMethod').value = method;
    document.getElementById('checkoutForm').submit();
  }

  function updateCardPreview() {
    const num = document.getElementById('cardNumberInput').value || '4532 •••• •••• 8829';
    const name = document.getElementById('cardNameInput').value || 'ALEXANDER STERLING';
    const exp = document.getElementById('cardExpInput').value || '12/28';
    document.getElementById('cardDisplayNumber').textContent = num;
    document.getElementById('cardDisplayName').textContent = name.toUpperCase();
    document.getElementById('cardDisplayExp').textContent = exp;
  }
</script>

<%- include('../partials/footer') %>
