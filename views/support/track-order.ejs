<%- include('../partials/header', { pageTitle: 'Real-Time Package Tracking — VisionVogue' }) %>

<div class="container-xl" style="padding:40px 24px 90px;">
  
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom reveal">
    <div>
      <span class="text-gold text-uppercase fw-semibold" style="letter-spacing:1.5px; font-size:12px;">Live Fulfillment Pipeline</span>
      <h1 class="font-display display-5 text-dark fw-bold mb-0">Real-Time Order Tracking</h1>
    </div>
    <div class="mt-3 mt-md-0">
      <span class="badge bg-dark text-gold p-2 px-3"><i class="fa-solid fa-satellite-dish me-1 text-gold"></i> Live Database Connected</span>
    </div>
  </div>

  <div class="row g-4">
    <div class="col-lg-3"><%- include('../partials/support-sidebar') %></div>
    
    <div class="col-lg-9">
      <!-- Search Input Card -->
      <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-4 reveal">
        <form action="/support/track-order" method="GET" class="row g-2 align-items-center">
          <div class="col-md-9">
            <div class="input-group">
              <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-gold"></i></span>
              <input type="text" name="order" class="form-control border-start-0 py-2 fs-6" placeholder="Enter Order # (e.g. VV984210)" value="<%= typeof order !== 'undefined' && order ? order.orderNumber : '' %>" required>
            </div>
          </div>
          <div class="col-md-3">
            <button type="submit" class="btn btn-dark w-100 py-2 fw-semibold" style="background:var(--dark-grey); color:var(--gold);">Track Package</button>
          </div>
        </form>
      </div>

      <% if (typeof order !== 'undefined' && order) { %>
        <!-- Live Order Status Card -->
        <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 bg-white mb-4 reveal">
          
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center pb-3 border-bottom mb-4 gap-3">
            <div>
              <span class="badge bg-gold text-dark font-mono mb-2 px-3 py-1">ORDER #<%= order.orderNumber %></span>
              <h2 class="font-display h3 fw-bold text-dark mb-1">Status: <%= order.status %></h2>
              <span class="text-muted small">Placed on <%= new Date(order.createdAt).toLocaleString('en-IN', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %></span>
            </div>
            
            <div class="text-md-end">
              <span class="text-muted small d-block">Payment Method</span>
              <span class="fw-bold text-dark"><%= order.paymentMethod || 'UPI Instant' %> (<%= order.paymentStatus || 'Paid' %>)</span>
              <% if (order.paymentTxnId) { %>
                <span class="text-muted d-block small" style="font-size:11px;">Ref: <%= order.paymentTxnId %></span>
              <% } %>
            </div>
          </div>

          <!-- Lenskart / Flipkart Style Visual Timeline Progress Bar -->
          <div class="timeline-visual-wrapper my-4">
            <div class="d-flex justify-content-between position-relative mb-4" style="max-width: 100%;">
              
              <!-- Timeline Bar Line -->
              <div class="position-absolute top-50 start-0 translate-middle-y w-100 bg-light" style="height: 6px; z-index: 1;">
                <div class="bg-warning h-100" style="width: <%= order.status === 'Delivered' ? '100%' : order.status === 'In Transit' ? '66%' : order.status.includes('In Lab') ? '33%' : '15%' %>;"></div>
              </div>

              <!-- Milestone 1: Placed -->
              <div class="position-relative text-center" style="z-index: 2;">
                <div class="rounded-circle bg-warning text-dark font-mono mx-auto d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; border: 3px solid #fff;">
                  <i class="fa-solid fa-receipt"></i>
                </div>
                <span class="fw-bold text-dark small d-block mt-2">Order Placed</span>
                <span class="text-muted small" style="font-size:11px;">Payment Verified</span>
              </div>

              <!-- Milestone 2: Lens Fitting -->
              <div class="position-relative text-center" style="z-index: 2;">
                <div class="rounded-circle <%= order.status.includes('Lab') || order.status === 'In Transit' || order.status === 'Delivered' ? 'bg-warning text-dark' : 'bg-light text-muted' %> font-mono mx-auto d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; border: 3px solid #fff;">
                  <i class="fa-solid fa-glasses"></i>
                </div>
                <span class="fw-bold text-dark small d-block mt-2">Optical Lab</span>
                <span class="text-muted small" style="font-size:11px;">Laser Beveling</span>
              </div>

              <!-- Milestone 3: In Transit -->
              <div class="position-relative text-center" style="z-index: 2;">
                <div class="rounded-circle <%= order.status === 'In Transit' || order.status === 'Delivered' ? 'bg-warning text-dark' : 'bg-light text-muted' %> font-mono mx-auto d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; border: 3px solid #fff;">
                  <i class="fa-solid fa-plane-departure"></i>
                </div>
                <span class="fw-bold text-dark small d-block mt-2">In Transit</span>
                <span class="text-muted small" style="font-size:11px;">Blue Dart Air</span>
              </div>

              <!-- Milestone 4: Delivered -->
              <div class="position-relative text-center" style="z-index: 2;">
                <div class="rounded-circle <%= order.status === 'Delivered' ? 'bg-success text-white' : 'bg-light text-muted' %> font-mono mx-auto d-flex align-items-center justify-content-center shadow-sm" style="width: 42px; height: 42px; border: 3px solid #fff;">
                  <i class="fa-solid fa-house-chimney-check"></i>
                </div>
                <span class="fw-bold text-dark small d-block mt-2">Delivered</span>
                <span class="text-muted small" style="font-size:11px;">Doorstep Handover</span>
              </div>

            </div>
          </div>

          <!-- Items Ordered List -->
          <div class="p-3 bg-light rounded-4 border mb-4">
            <h5 class="font-display h6 fw-bold text-dark mb-3">Eyewear Package Items</h5>
            <% if (order.items && order.items.length > 0) { %>
              <% order.items.forEach(item => { %>
                <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                  <div class="d-flex align-items-center gap-3">
                    <img src="<%= item.image %>" alt="<%= item.name %>" class="rounded bg-white p-1 border" style="width:50px; height:50px; object-fit:contain;">
                    <div>
                      <strong class="text-dark d-block" style="font-size:14px;"><%= item.name %></strong>
                      <span class="text-gold small" style="font-size:12px;"><i class="fa-solid fa-layer-group me-1"></i> <%= item.lensUpgrade %> (Qty: <%= item.qty %>)</span>
                    </div>
                  </div>
                  <div class="fw-bold text-dark">₹<%= ((item.price + item.lensPrice) * item.qty).toLocaleString('en-IN') %></div>
                </div>
              <% }) %>
            <% } %>
            <div class="d-flex justify-content-between align-items-center pt-3">
              <span class="fw-bold text-dark">Total Amount Paid:</span>
              <span class="font-display h4 fw-bold text-dark mb-0">₹<%= order.totalAmount.toLocaleString('en-IN') %></span>
            </div>
          </div>

          <!-- Shipping Destination -->
          <% if (order.shippingDetails) { %>
            <div class="row g-3">
              <div class="col-md-6">
                <div class="p-3 bg-white border rounded-3 h-100">
                  <span class="text-gold text-uppercase fw-semibold d-block mb-1" style="font-size:11px;">Delivery Recipient</span>
                  <strong class="text-dark d-block"><%= order.shippingDetails.fullName %></strong>
                  <span class="text-muted small d-block"><i class="fa-solid fa-phone me-1"></i> <%= order.shippingDetails.phone %></span>
                </div>
              </div>
              <div class="col-md-6">
                <div class="p-3 bg-white border rounded-3 h-100">
                  <span class="text-gold text-uppercase fw-semibold d-block mb-1" style="font-size:11px;">Destination Address</span>
                  <span class="text-dark small d-block"><%= order.shippingDetails.address %>, <%= order.shippingDetails.city %> - <%= order.shippingDetails.pincode %></span>
                </div>
              </div>
            </div>
          <% } %>

        </div>
      <% } else if (typeof order !== 'undefined') { %>
        <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white reveal">
          <i class="fa-solid fa-box-open text-muted mb-3" style="font-size:48px;"></i>
          <h4 class="font-display fw-bold text-dark mb-2">No Order Found with that Number</h4>
          <p class="text-muted small mb-0">Please check your order number from your email confirmation or account dashboard.</p>
        </div>
      <% } %>

      <!-- Recent Orders List -->
      <% if (recentOrders && recentOrders.length > 0) { %>
        <div class="card border-0 shadow-sm p-4 rounded-4 bg-white reveal">
          <h4 class="font-display h5 fw-bold text-dark mb-3">Your Saved Account Orders</h4>
          <div class="list-group list-group-flush">
            <% recentOrders.forEach(o => { %>
              <a href="/support/track-order?order=<%= o.orderNumber %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3">
                <div>
                  <strong class="text-dark">Order #<%= o.orderNumber %></strong>
                  <span class="text-muted d-block small"><%= new Date(o.createdAt).toLocaleDateString('en-IN') %> · ₹<%= o.totalAmount.toLocaleString('en-IN') %></span>
                </div>
                <span class="badge bg-dark text-gold px-3 py-2"><%= o.status %> <i class="fa-solid fa-chevron-right ms-1"></i></span>
              </a>
            <% }) %>
          </div>
        </div>
      <% } %>

    </div>
  </div>

</div>

<%- include('../partials/footer') %>
