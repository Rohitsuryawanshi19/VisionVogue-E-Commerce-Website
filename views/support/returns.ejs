<%- include('../partials/header', { pageTitle: 'Returns & Exchange — VisionVogue' }) %>

<div class="container-xl" style="padding:36px 24px 90px;">
  <h2 class="reveal">Returns & Exchange</h2>
  <div class="row" style="margin-top:20px;">
    <div class="col-lg-3 mb-4"><%- include('../partials/support-sidebar') %></div>
    <div class="col-lg-9">
      <div class="sidebar-filter reveal">
        <h5>Our 14-Day Return Policy</h5>
        <p style="color:var(--text-muted);font-size:14.5px;line-height:1.7;">
          Not the right fit? You can return or exchange any unworn frame within 14 days of delivery, no questions asked.
        </p>
        <ol style="font-size:14.5px;color:#444;line-height:2;">
          <li>Go to <a href="/support/track-order" style="color:var(--gold);">Track Order</a> and select the item.</li>
          <li>Choose "Return" or "Exchange" and select a reason.</li>
          <li>Schedule a free pickup from your address.</li>
          <li>Refund or replacement is processed within 5-7 business days of pickup.</li>
        </ol>
        <div class="trust-badges" style="margin-top:24px;">
          <div class="trust-badge"><i class="fa-solid fa-rotate-left"></i> Free Pickup</div>
          <div class="trust-badge"><i class="fa-solid fa-wallet"></i> Full Refund</div>
          <div class="trust-badge"><i class="fa-solid fa-shield-halved"></i> 365-Day Warranty</div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
